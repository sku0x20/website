---
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/nav.css';
import '../styles/buttons.css';
import '../styles/home.css';
import '../styles/about.css';
import '../styles/blog.css';
import '../styles/article.css';
import '../styles/cv.css';
import '../styles/resume.css';
import '../styles/responsive.css';

interface Props {
    title: string;
    description?: string;
    image?: string;
    type?: 'website' | 'article';
}

const {
    title,
    description = 'Siddhant Kumar Upmanyu — Senior Systems Architect. Notes on backend systems, kernel networking, and distributed storage.',
    image,
    type = 'website',
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image ? new URL(image, Astro.site) : undefined;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalURL}>

    <meta property="og:type" content={type}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalURL}>
    {ogImageURL && <meta property="og:image" content={ogImageURL}>}

    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'}>
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    {ogImageURL && <meta name="twitter:image" content={ogImageURL}>}

    <ClientRouter />

    <!-- Inline script to prevent theme flash and maintain theme across transitions -->
    <script is:inline>
        function initTheme() {
            try {
                const stored = localStorage.getItem('theme');
                if (stored === 'dark' || stored === 'light') {
                    document.documentElement.setAttribute('data-theme', stored);
                } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.setAttribute('data-theme', 'light');
                }
            } catch (e) {}
        }
        initTheme();
        document.addEventListener('astro:after-swap', initTheme);

        document.addEventListener('click', function(e) {
            const toggle = e.target.closest('#theme-toggle');
            if (!toggle) return;
            const current = document.documentElement.getAttribute('data-theme');
            const target = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', target);
            try {
                localStorage.setItem('theme', target);
            } catch (err) {}
        });

        // Spotlight cursor tracking for cards
        let mouseRaf = null;
        window.addEventListener('pointermove', function(e) {
            const card = e.target.closest('.project-card, .writing-item, .post-card, .value-cell, .cv-project-card, .cv-scope-box');
            if (!card) return;
            if (mouseRaf) return;
            mouseRaf = requestAnimationFrame(function() {
                const rect = card.getBoundingClientRect();
                card.style.setProperty('--mouse-x', (e.clientX - rect.left) + 'px');
                card.style.setProperty('--mouse-y', (e.clientY - rect.top) + 'px');
                mouseRaf = null;
            });
        }, { passive: true });

        // Smart sticky nav: reveal on scroll-up, hide on scroll-down
        let lastScrollY = Math.max(0, window.scrollY);
        let scrollTicking = false;

        function handleNavScroll() {
            const nav = document.querySelector('.nav');
            if (!nav) return;
            const currentScrollY = Math.max(0, window.scrollY);

            if (currentScrollY <= 60) {
                nav.classList.remove('nav--hidden', 'nav--scrolled');
            } else {
                nav.classList.add('nav--scrolled');
                if (currentScrollY > lastScrollY + 8) {
                    nav.classList.add('nav--hidden');
                } else if (currentScrollY < lastScrollY - 8) {
                    nav.classList.remove('nav--hidden');
                }
            }
            lastScrollY = currentScrollY;
            scrollTicking = false;
        }

        function updateReadingProgress() {
            const bar = document.getElementById('reading-progress');
            if (!bar) return;
            const total = document.documentElement.scrollHeight - window.innerHeight;
            if (total <= 0) {
                bar.style.transform = 'scaleX(0)';
                return;
            }
            const progress = Math.min(1, Math.max(0, window.scrollY / total));
            bar.style.transform = `scaleX(${progress})`;
        }

        window.addEventListener('scroll', function() {
            if (!scrollTicking) {
                requestAnimationFrame(function() {
                    handleNavScroll();
                    updateReadingProgress();
                });
                scrollTicking = true;
            }
        }, { passive: true });

        // Interactive Code Block Copy Buttons
        function initCodeCopy() {
            document.querySelectorAll('.prose pre').forEach(function(pre) {
                if (pre.querySelector('.code-copy-btn')) return;
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'code-copy-btn';
                btn.setAttribute('aria-label', 'Copy code snippet');
                btn.textContent = 'Copy';
                
                btn.addEventListener('click', async function() {
                    const code = pre.querySelector('code')?.innerText || pre.innerText;
                    try {
                        await navigator.clipboard.writeText(code.trim());
                        btn.classList.add('copied');
                        btn.textContent = 'Copied ✓';
                        setTimeout(function() {
                            btn.classList.remove('copied');
                            btn.textContent = 'Copy';
                        }, 2000);
                    } catch (err) {}
                });

                pre.appendChild(btn);
            });
        }

        document.addEventListener('astro:after-swap', function() {
            lastScrollY = 0;
            const nav = document.querySelector('.nav');
            if (nav) {
                nav.classList.remove('nav--hidden', 'nav--scrolled');
            }
            initCodeCopy();
            updateReadingProgress();
        });

        // Developer Console Easter Egg
        if (!window.__easterEggLogged) {
            window.__easterEggLogged = true;
            console.log(
                '%c' +
                '   ____  _     _     _                 _   \n' +
                '  / ___|(_) __| | __| |__   __ _ _ __ | |_ \n' +
                '  \\___ \\| |/ _` |/ _` \'_ \\ / _` | \'_ \\| __|\n' +
                '   ___) | | (_| | (_| | | | (_| | | | | |_ \n' +
                '  |____/|_|\\__,_|\\__,_| |_|\\__,_|_| |_|\\__|\n\n' +
                '  Siddhant Kumar Upmanyu — Systems Architect\n' +
                '  Backend Systems • Kernel Networking • Distributed Storage\n' +
                '  https://github.com/sku0x20 // sku20.dev\n',
                'color: #e56847; font-family: monospace; font-size: 11px; font-weight: bold;'
            );
        }

        // Interactive Distributed Systems Node Mesh
        function initMesh() {
            const canvas = document.getElementById('bg-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (!ctx) return;

            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                return;
            }

            let width = window.innerWidth;
            let height = window.innerHeight;
            let dpr = Math.min(window.devicePixelRatio || 1, 2);

            function resize() {
                width = window.innerWidth;
                height = window.innerHeight;
                dpr = Math.min(window.devicePixelRatio || 1, 2);
                canvas.width = width * dpr;
                canvas.height = height * dpr;
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            }
            resize();

            window.addEventListener('resize', resize, { passive: true });

            const count = width < 768 ? 26 : 52;
            const nodes = [];

            for (let i = 0; i < count; i++) {
                nodes.push({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    vx: (Math.random() - 0.5) * 0.4,
                    vy: (Math.random() - 0.5) * 0.4,
                    radius: Math.random() * 1.2 + 1.2,
                });
            }

            let mouse = { x: -9999, y: -9999, active: false };

            window.addEventListener('pointermove', function(e) {
                mouse.x = e.clientX;
                mouse.y = e.clientY;
                mouse.active = true;
            }, { passive: true });

            window.addEventListener('pointerleave', function() {
                mouse.active = false;
                mouse.x = -9999;
                mouse.y = -9999;
            });

            const LINK_DIST = 120;
            const MOUSE_DIST = 150;
            let animId = null;

            function render() {
                ctx.clearRect(0, 0, width, height);

                const isDark = document.documentElement.getAttribute('data-theme') === 'dark' ||
                    (!document.documentElement.getAttribute('data-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);

                const nodeColor = isDark ? 'rgba(229, 104, 71, 0.7)' : 'rgba(196, 71, 39, 0.65)';
                const linkBase = isDark ? '232, 236, 242' : '22, 24, 29';
                const mouseLinkBase = isDark ? '229, 104, 71' : '196, 71, 39';

                for (let i = 0; i < nodes.length; i++) {
                    const n = nodes[i];
                    n.x += n.vx;
                    n.y += n.vy;

                    if (n.x < 0) { n.x = 0; n.vx *= -1; }
                    else if (n.x > width) { n.x = width; n.vx *= -1; }
                    if (n.y < 0) { n.y = 0; n.vy *= -1; }
                    else if (n.y > height) { n.y = height; n.vy *= -1; }

                    if (mouse.active) {
                        const dx = n.x - mouse.x;
                        const dy = n.y - mouse.y;
                        const dist = Math.hypot(dx, dy);
                        if (dist < MOUSE_DIST && dist > 0) {
                            const alpha = (1 - dist / MOUSE_DIST) * 0.35;
                            ctx.strokeStyle = `rgba(${mouseLinkBase}, ${alpha})`;
                            ctx.lineWidth = 1;
                            ctx.beginPath();
                            ctx.moveTo(n.x, n.y);
                            ctx.lineTo(mouse.x, mouse.y);
                            ctx.stroke();

                            const force = ((MOUSE_DIST - dist) / MOUSE_DIST) * 0.5;
                            n.x += (dx / dist) * force;
                            n.y += (dy / dist) * force;
                        }
                    }
                }

                for (let i = 0; i < nodes.length; i++) {
                    const p1 = nodes[i];
                    for (let j = i + 1; j < nodes.length; j++) {
                        const p2 = nodes[j];
                        const dx = p1.x - p2.x;
                        const dy = p1.y - p2.y;
                        const dist = Math.hypot(dx, dy);

                        if (dist < LINK_DIST) {
                            const alpha = (1 - dist / LINK_DIST) * 0.12;
                            ctx.strokeStyle = `rgba(${linkBase}, ${alpha})`;
                            ctx.lineWidth = 0.8;
                            ctx.beginPath();
                            ctx.moveTo(p1.x, p1.y);
                            ctx.lineTo(p2.x, p2.y);
                            ctx.stroke();
                        }
                    }
                }

                ctx.fillStyle = nodeColor;
                for (let i = 0; i < nodes.length; i++) {
                    const n = nodes[i];
                    ctx.beginPath();
                    ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
                    ctx.fill();
                }

                animId = requestAnimationFrame(render);
            }

            animId = requestAnimationFrame(render);

            document.addEventListener('visibilitychange', function() {
                if (document.hidden) {
                    cancelAnimationFrame(animId);
                } else {
                    animId = requestAnimationFrame(render);
                }
            });
        }

        function initPageFeatures() {
            initMesh();
            initCodeCopy();
            updateReadingProgress();
        }

        if (!window.__meshInitialized) {
            window.__meshInitialized = true;
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initPageFeatures);
            } else {
                initPageFeatures();
            }
        } else {
            initCodeCopy();
            updateReadingProgress();
        }
    </script>
</head>
<body>
    <canvas id="bg-canvas" class="bg-canvas" transition:persist="bg-canvas"></canvas>
    {type === 'article' && <div id="reading-progress" class="reading-progress" aria-hidden="true" />}
    <nav class="nav">
        <a href="/" class="nav-brand">
            <span>S. UPMANYU</span>
            <span class="nav-brand-tag">SYS</span>
        </a>
        <div class="nav-links">
            <a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
            <a href="/cv" aria-current={isActive('/cv') ? 'page' : undefined}>CV</a>
            <a href="/blog" aria-current={isActive('/blog') ? 'page' : undefined}>Blog</a>
            <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark/light mode" title="Toggle theme">
                <!-- Sun icon (shown in dark mode) -->
                <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
                <!-- Moon icon (shown in light mode) -->
                <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
            </button>
        </div>
    </nav>

    <main>
        <slot />
    </main>

    <footer class="site-footer">
        <div>&copy; {new Date().getFullYear()} Siddhant Kumar Upmanyu &mdash; Systems &amp; Infrastructure</div>
        <div class="site-footer-links">
            <span class="telemetry-pill">SYS_OK &bull; 0.4ms</span>
            <a href="https://github.com/sku0x20" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="https://www.linkedin.com/in/sku20" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a href="https://doi.org/10.5281/zenodo.21717242" target="_blank" rel="noopener noreferrer">Preprint</a>
            <a href="mailto:siddhantkumarupmanyu@gmail.com">Email</a>
        </div>
    </footer>
</body>
</html>
