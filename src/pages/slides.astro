---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const slides = (await getCollection('slides')).sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const getSlug = (id: string) => id.replace(/\/slides$/, '').replace(/\.md$/, '');
---

<Layout 
    title="Slides & Talks — Siddhant Kumar Upmanyu" 
    description="Technical presentations, architecture talks, and engineering slide decks."
>
    <section class="blog-header">
        <h1>Slides</h1>
        <p>Technical presentations, architecture talks, and engineering slide decks.</p>
    </section>

    <section class="blog-grid-wrap">
        <div class="blog-grid">
            {slides.map((deck) => (
                <a href={`/slides/${getSlug(deck.id)}/`} class="post-card">
                    <article>
                        <h3>{deck.data.title}</h3>
                        {deck.data.subtitle && <p style="font-weight: 600; margin-bottom: 4px;">{deck.data.subtitle}</p>}
                        {deck.data.description && <p>{deck.data.description}</p>}
                        <div class="post-meta-row">
                            <span class="post-meta">{deck.data.date}</span>
                            {deck.data.tags.map((t) => (
                                <>
                                    <span class="post-meta-bullet">&bull;</span>
                                    <span class="post-kicker">{t}</span>
                                </>
                            ))}
                            <span class="post-meta-bullet">&bull;</span>
                            <span class="post-kicker" style="color: var(--color-accent);">View Deck &rarr;</span>
                        </div>
                    </article>
                </a>
            ))}
        </div>
    </section>
</Layout>
