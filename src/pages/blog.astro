---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const getSlug = (id: string) => id.replace(/^\d{4}-\d{2}-\d{2}-/, '');
---

<Layout title="Blog — Siddhant Kumar Upmanyu" description="Technical notes on systems architecture, infrastructure, and the tradeoffs behind them.">
    <section class="blog-header">
        <h1>Blog</h1>
        <p>Technical notes on systems architecture, infrastructure, and the tradeoffs behind them.</p>
    </section>

    <section class="blog-grid-wrap">
        <div class="blog-grid">
            {posts.map((post) => (
                <a href={`/blog/${getSlug(post.id)}`} class="post-card">
                    <article>
                        <h3>{post.data.title}</h3>
                        <p>{post.data.description}</p>
                        <div class="post-meta-row">
                            <span class="post-meta">{post.data.date}</span>
                            {post.data.tags.map((t) => (
                                <>
                                    <span class="post-meta-bullet">&bull;</span>
                                    <span class="post-kicker">{t}</span>
                                </>
                            ))}
                        </div>
                    </article>
                </a>
            ))}
        </div>
    </section>
</Layout>
