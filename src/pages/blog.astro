---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout title="Blog — Siddhant Kumar Upmanyu">
    <section class="blog-header">
        <h1>Blog</h1>
        <p>Technical notes on systems architecture, infrastructure, and the tradeoffs behind them.</p>
    </section>

    <section class="blog-grid-wrap">
        <div class="blog-grid">
            {posts.map((post) => (
                <a href={`/blog/${post.id}`} class="post-card">
                    <article>
                        <div class="post-kicker">{post.data.tag}</div>
                        <h3>{post.data.title}</h3>
                        <p>{post.data.description}</p>
                        <div class="post-meta">{post.data.date}</div>
                    </article>
                </a>
            ))}
        </div>
    </section>
</Layout>
